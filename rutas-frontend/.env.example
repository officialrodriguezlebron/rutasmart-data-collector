# ───────────────────────────────────────────────────────────
# RutaSmart Frontend — Environment Variables
# Copy this file to .env.local for local dev
# Configure on Vercel dashboard for production
# ───────────────────────────────────────────────────────────

# Backend API base URL (Railway deployment)
VITE_API_URL=https://your-backend.up.railway.app

# Shared API key — must match RUTASMART_API_KEY on the backend
VITE_API_KEY=change-me-to-a-long-random-string
