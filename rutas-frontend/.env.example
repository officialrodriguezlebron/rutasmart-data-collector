# ─────────────────────────────────────────────────────────────────────────────
# RutaSmart Frontend — Environment Variables
# Copy this file to .env.local for local development.
# .env.local is gitignored. Never commit real values.
#
# WARNING: every VITE_* variable is inlined into the production JavaScript
# bundle and is readable by anyone who loads the site. VITE_API_KEY is
# therefore not a secret — treat it as public. Never put a true secret here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Local development ───────────────────────────────────────────────────────
# Backend base URL, no trailing slash.
# There is no Vite dev proxy, so this MUST be set or every API call fails.
VITE_API_URL=http://127.0.0.1:8000

# Shared API key. Leave EMPTY for local development so that it matches an
# empty RUTASMART_API_KEY on the backend.
VITE_API_KEY=

# ── Deployed frontend ───────────────────────────────────────────────────────
# Set these in the hosting provider's dashboard, not in a committed file:
#   VITE_API_URL=https://your-backend.example.com
#   VITE_API_KEY=<must match RUTASMART_API_KEY on the backend>
