# ───────────────────────────────────────────────────────────
# RutaSmart Backend — Environment Variables
# Copy this file to .env and fill in the actual values
# ───────────────────────────────────────────────────────────

# Database connection string (PostgreSQL on Railway)
DATABASE_URL=postgresql://user:password@host:port/database

# Shared API key — must match VITE_API_KEY on the frontend
RUTASMART_API_KEY=change-me-to-a-long-random-string

# Allowed frontend URL for CORS (Vercel production URL)
FRONTEND_URL=https://your-frontend.vercel.app

# Environment flag — set to "production" to disable /auth/seed
ENV=development
