# ─────────────────────────────────────────────────────────────────────────────
# RutaSmart Backend — Environment Variables
# Copy this file to .env and fill in the values for your machine.
# .env is gitignored. Never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
#   Local development — substitute your own role, password and database:
#     postgresql://USER:PASSWORD@localhost:5432/rutasmart_db
#   Deployed — use the connection string injected by the hosting platform.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# ── Optional ─────────────────────────────────────────────────────────────────
# Shared API key, matched against the X-API-Key request header and against
# VITE_API_KEY in the frontend environment.
#
# Leave EMPTY for local development. An empty value disables the API-key
# middleware completely, which is how the local setup is expected to run.
# Generate a value only for a deployed backend:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
RUTASMART_API_KEY=

# Additional browser origin permitted through CORS. It is appended to the
# built-in ALLOWED_ORIGINS list in app/main.py. Local development needs
# nothing here — http://localhost:5173 and http://127.0.0.1:5173 are built in.
FRONTEND_URL=

# Secret used to HMAC-sign session tokens (app/security.py).
#
# Leave EMPTY for local development: the backend generates a random secret per
# process, so no configuration is needed. The cost is that tokens stop
# verifying after a restart, which is harmless locally.
#
# REQUIRED for any deployment. Without it each worker signs with a different
# random secret, so sessions break across restarts and across instances.
# Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Treat it like a password: rotating it invalidates every active session.
RUTASMART_TOKEN_SECRET=

# Set to "production" to disable the POST /auth/seed endpoint.
# Any other value, or unset, is treated as development.
ENV=development
